# Copy to .env.local. Demo needs no credentials. Never commit .env.local.
APP_MODE=demo
LIBBIE_DB=data/libbie.db
MODEL_PROVIDER=none
MODEL_API_KEY=
RUNTIME_MODEL=
SIMULATOR_MODEL=
TEACHER_MODEL=
JUDGE_MODEL=
MAX_SIMULATION_TURNS=12
MAX_MODEL_CALLS_PER_RUN=40
MAX_MODEL_OUTPUT_TOKENS=2000
MAX_PARALLEL_RUNS=2
MODEL_TIMEOUT_MS=20000
# APP_MODE=live enables provider-backed simulated clients and draft replies.
# MODEL_PROVIDER=openai uses https://api.openai.com/v1/responses.
# Set role model IDs that your account can access and that support structured output.
# Extractor/search/replay remain deterministic in both modes. Teacher/judge reserved.
